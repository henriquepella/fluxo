# Runtime
NODE_ENV=development
PORT=3001

# Database — SQLite in dev; use PostgreSQL in production
# (postgresql://fluxo:fluxo@localhost:5432/fluxo?schema=public with docker-compose)
DATABASE_URL=file:./dev.db

# Cache / queues
REDIS_URL=redis://localhost:6379

# CORS — frontend origin
CORS_ORIGIN=http://localhost:3000

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
